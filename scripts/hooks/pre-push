#!/usr/bin/env bash
# pre-push hook for the Coati public repository: refuses to push if the pushed
# tree contains:
# - an internal file (interne/, notes/, MEMORY.md, JOURNAL.md, .pem key, .env);
# - a real secret pattern (private key, long API key, GitHub token, AWS key);
#   short fake test keys ("sk-ant-fake") do not trigger it;
# - a dependency reserved for personal modules, or a reference to the private
#   repository outside CLAUDE.md. These two patterns are assembled in pieces
#   below so this file does not refuse itself.
#
# Install in a clone: cp scripts/hooks/pre-push .git/hooks/pre-push
#                     chmod +x .git/hooks/pre-push
# CI also replays it (.github/workflows/tests.yml) as a last safety net.
set -euo pipefail

FORBIDDEN='^(interne|notes)(/|$)|^(MEMORY|JOURNAL)\.md$|\.pem$|(^|/)\.env(\.|$)'
SECRET='BEGIN [A-Z ]*PRIVATE KEY|sk-ant-[A-Za-z0-9_-]{40,}|sk-(proj-)?[A-Za-z0-9_-]{40,}|gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{40,}|AKIA[0-9A-Z]{16}'
PERSONAL_DEP="claude-agent""-sdk"
PRIVATE_REF="coati-""interne/"

status=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  # Deleting a remote branch: nothing to check.
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi
  if git ls-tree -r --name-only "$local_sha" | grep -nE "$FORBIDDEN" >&2; then
    echo "pre-push: internal file in the public repository, push refused." >&2
    status=1
  fi
  if git grep -nIE "$SECRET" "$local_sha" -- . >&2; then
    echo "pre-push: secret pattern found, push refused." >&2
    status=1
  fi
  if git grep -nIF "$PERSONAL_DEP" "$local_sha" -- . >&2; then
    echo "pre-push: dependency reserved for personal modules, push refused." >&2
    status=1
  fi
  if git grep -nIF "$PRIVATE_REF" "$local_sha" -- . ':!CLAUDE.md' >&2; then
    echo "pre-push: reference to private repository outside CLAUDE.md, push refused." >&2
    status=1
  fi
done

exit "$status"
